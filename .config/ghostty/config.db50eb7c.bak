font-family               =  "Iosevka Term Light"
font-family-bold          =  "Iosevka Term SemiBold"
font-family-italic        =  "Iosevka Term Light Italic"
font-family-bold-italic   =  "Iosevka Term SemiBold Italic"

font-size = "15"
theme = "Builtin Solarized Light"
cursor-style = "block"
bold-is-bright = "true"

keybind = global:ctrl+grave_accent=toggle_quick_terminal
macos-option-as-alt = "true"
macos-titlebar-style = "tabs"
